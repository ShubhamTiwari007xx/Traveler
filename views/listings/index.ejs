<% layout('layouts/boilerplate') -%>

    <body>

        <div id="filters">
            <div class="filter">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </div>

            <div class="filter">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </div>

            <div class="filter">
                <div><i class="fa-solid fa-city"></i></div>
                <p>Iconic Cities</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Mountains</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-bowl-food"></i></div>
                <p>Foods</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-house"></i></div>
                <p>House</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-person-swimming"></i></div>
                <p>pools</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-anchor"></i></div>
                <p>Cruise</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-archway"></i></div>
                <p>Castles</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-earth-americas"></i></div>
                <p>International</p>
            </div>

            <div class="tax-toggle ms-auto">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                    <label class="form-check-label" for="switchCheckDefault">Display total after Taxes</label>
                </div>
            </div>

        </div>

        <div class="row row-cols-lg-3  row-cols-md-2 row-cols-sm-1 g-4 ">
            <% for(let listing of allListings) { %>
                <a href="/listings/<%= listing._id %> ">
                    <div class="card">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="listing image"
                            style="height: 20rem; object-fit: cover; ">
                        <div class="card-body">

                            <div class="card-img-overlay"></div>
                            <p class="card-text">
                                <%= listing.title %> <br>
                                    <%= listing.price.toLocaleString("en-IN") %> /Night <br>
                                    <i class="tax" style="display: none;"> &nbsp;+18% GST</i>

                            </p>

                        </div>
                    </div>
                    <% } %>
        </div>


        <script>
            let PriceToggle = document.getElementById("switchCheckDefault");
            PriceToggle.addEventListener("click", function() {
               let taxInf = document.getElementsByClassName("tax")
               for (inf of taxInf){
                if (inf.style.display != "inline"){
                    inf.style.display = "inline"
            
                }else{
                    inf.style.display = "none"
                }
            }
            });
        </script>

    </body>