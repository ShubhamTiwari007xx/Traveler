<% layout('layouts/boilerplate') -%>
<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<div class="row">

  <!-- LISTING CARD -->
  <div class="card col-5 offset-3 show-card">
    <h3 class="card-title text-center mt-3">
      <%= listing.title %>
    </h3>

    <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing image">

    <div class="card-body">
      <p class="card-text">
        Owned by:
        <i><%= listing.owner.username %></i>
      </p>

      <ul>
        <li><%= listing.description %></li>
        <li>
          <span>&#8377;</span>
          <%= listing.price.toLocaleString("en-IN") %>
        </li>
        <li><%= listing.location %></li>
        <li><%= listing.country %></li>
      </ul>
    </div>
  </div>

  <!-- EDIT / DELETE BUTTONS -->
  <% if (currentUser && listing.owner._id.equals(currentUser._id)) { %>
    <div class="btns">
      <a class="btn btn-danger offset-3" href="/listings/<%= listing._id %>/edit">
        Edit
      </a>

      <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
        <button class="btn btn-dark offset-3 mt-2">Delete</button>
      </form>
    </div>
  <% } %>

</div>

<hr>

<!-- ADD REVIEW -->
<div class="row">
  <div class="col-8 offset-3 mt-4 mb-4">
    <h3>Add a Review</h3>

    <% if (currentUser) { %>
      <form
        action="/listings/<%= listing._id %>/reviews"
        method="POST"
        novalidate
        class="needs-validation"
      >

        <fieldset class="starability-slot">
          <input type="radio" id="no-rate" class="input-no-rate"
                 name="review[rating]" value="1" checked />
          <input type="radio" id="rate1" name="review[rating]" value="1" />
          <label for="rate1" title="Terrible">1 star</label>

          <input type="radio" id="rate2" name="review[rating]" value="2" />
          <label for="rate2" title="Not good">2 stars</label>

          <input type="radio" id="rate3" name="review[rating]" value="3" />
          <label for="rate3" title="Average">3 stars</label>

          <input type="radio" id="rate4" name="review[rating]" value="4" />
          <label for="rate4" title="Very good">4 stars</label>

          <input type="radio" id="rate5" name="review[rating]" value="5" />
          <label for="rate5" title="Amazing">5 stars</label>
        </fieldset>

        <div class="form-group mt-3">
          <label for="comment">Comments</label>
          <textarea
            class="form-control"
            id="comment"
            name="review[comment]"
            rows="3"
            required
          ></textarea>
          <div class="invalid-feedback">
            Please provide a comment.
          </div>
        </div>

        <button class="btn btn-dark mt-2">Submit Review</button>

      </form>
    <% } %>
  </div>
</div>



<!-- REVIEWS -->
<p class="text-center"><b>Reviews</b></p>

<div class="row ms-auto me-auto">
  <% for (let review of listing.reviews) { %>
    <div class="card col-6 mb-5">
      <div class="card-body">

        <h6 class="card-title">
          @<%= review.author.username %>
        </h6>

        <p class="card-text">
          <%= review.comment %>
        </p>

        <p
          class="starability-result"
          data-rating="<%= review.rating %>"
        ></p>

        <% if (currentUser && review.author._id.equals(currentUser._id)) { %>
          <form
            method="POST"
            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
          >
            <button class="btn btn-danger mt-2 mb-3">
              Delete Review
            </button>
          </form>
        <% } %>

      </div>
    </div>
  <% } %>
</div>

<div id="map" style="height: 400px; width: 95%; margin-top: 20px;">
</div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
  // Default coordinates (Usa center)
  const lat = 39.8283;
  const lng = -98.5795;

  // Initialize map
  const map = L.map("map").setView([lat, lng], 5);

  // Load OpenStreetMap tiles
  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution: "&copy; OpenStreetMap contributors",
  }).addTo(map);

  // Marker
  L.marker([lat, lng])
    .addTo(map)
    // .bindPopup("<b><%= listing.title %></b><br><%= listing.location %>, <%= listing.country %>")
    .openPopup();
</script>
