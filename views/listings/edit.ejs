<% layout('layouts/boilerplate') %>

<body>
    <div class="container mt-5">
        <h1>Edit Listing</h1>

        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
            <!-- Title -->
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input 
                    id="title"
                    name="listing[title]" 
                    type="text" 
                    value="<%= listing.title %>" 
                    class="form-control" 
                    required>
                <div class="invalid-feedback">Title should not be empty</div>
            </div>

            <!-- Description -->
            <div class="mb-3">
                <label for="description" class="form-label">Description</label>
                <textarea 
                    id="description"
                    name="listing[description]" 
                    class="form-control" 
                    required><%= listing.description %></textarea>
            </div>

            <!-- Image URL -->
            <div class="mb-3">
                <h6>Current Image:</h6>
                <img src="<%= listing.image.url %>" alt="Current Image" style="max-width: 200px; display: block; margin-bottom: 10px;">
            </div>
            <div class="mb-3">
                <label for="imageUrl" class="form-label">Upload Image </label>
                <input 
                    id="imageUrl"
                    name="listing[image]" 
                    type="file" 
                    class="form-control" 
                    >
            </div>

            <!-- Price -->
            <div class="mb-3">
                <label for="price" class="form-label">Price</label>
                <input 
                    id="price"
                    type="number" 
                    name="listing[price]" 
                    value="<%= listing.price %>" 
                    class="form-control" 
                    required>
            </div>

            <!-- Location -->
            <div class="row">
                <div class="mb-3 col-md-6">
                    <label for="location" class="form-label">Location</label>
                    <input 
                        id="location"
                        type="text" 
                        name="listing[location]" 
                        value="<%= listing.location %>" 
                        class="form-control" 
                        required>
                </div>

                <div class="mb-3 col-md-6">
                    <label for="country" class="form-label">Country</label>
                    <input 
                        id="country"
                        type="text" 
                        name="listing[country]" 
                        value="<%= listing.country %>" 
                        class="form-control" 
                        required>
                </div>
            </div>

            <button class="btn btn-dark" type="submit">Edit Listing</button>
        </form>
    </div>

    <script src="/js/script.js"></script>
</body>
