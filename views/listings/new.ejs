<% layout('layouts/boilerplate') -%>
<body>
    <h1>Create New Listing</h1>
    <div class="row">
        <div class="col-8 offset-2">

    <form  method="POST" action="/listings"  novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="row">
    <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input type="text" name="listing[title]" class="form-control" required>
        <div class="invalid-feedback bold">Title should not be Empty</div>
    </div>
    <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" class="form-control" required></textarea>
         <div class="invalid-feedback bold">Please enter a Description </div>

    </div>
   <!-- <div class="mb-3">
    <label for="imageURL" class="form-label">Image URL</label>
    <input type="text" name="listing[image][url]" class="form-control">

</div> -->
   <div class="mb-3">
    <label for="imageURL" class="form-label">Upload Listing Image</label>
    <input type="file" name="listing[image]" class="form-control" required>
        <div class="invalid-feedback bold">Please upload an Image </div>
</div>



     <br>   
    <div class="mb-3">
        <label for="price" class="form-label">Price</label>
        <input type="number" name="listing[price]" class="form-control" required>
         <div class="invalid-feedback bold">Enter a Valid Value </div>
    </div>
    <div class="row">
        <div class="mb-3 col-md-4">
        <label for="location" class="form-label">Location</label>
        <input type="text" name="listing[location]" class="form-control" required>
         <div class="invalid-feedback bold">location name should be valid</div>
    </div>
    <div class="mb-3 col-md-8">
        <label for="country" class="form-label">Country</label>
        <input type="text" name="listing[country]" class="form-control" required>
         <div class="invalid-feedback bold">Country should be valid</div>
    </div>

    </div>
  

   <button class="btn btn-dark row-cols-md-2" type="submit">Add </button>
</form>
  </div>
        </div>
</body>
